# Public site URL used in generated Tail What's Left links.
PUBLIC_BASE_URL=https://parlayping.net

# Optional: enables screenshot/image and stronger text slip extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# X API user-context credentials for @ParlayPing.
# Never commit real credentials. Configure these in Vercel project environment variables.
X_USER_ID=
X_USER_ACCESS_TOKEN=

# Protects /api/x-worker from arbitrary invocation.
X_WORKER_SECRET=

# Safety gates. Keep both false until X has granted any required approval
# and the bot has passed dry-run QA.
X_AI_REPLY_APPROVED=false
X_AUTOREPLY_ENABLED=false
