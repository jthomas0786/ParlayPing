# Public site URL used in generated Tail What's Left links.
PUBLIC_BASE_URL=https://parlayping.net

# Dedicated ParlayPing Supabase project. The publishable key is safe for browser use.
# The Vercel app intentionally does NOT need a Supabase service-role key; privileged
# API-key validation stays inside Supabase Edge Functions.
SUPABASE_URL=https://avwqjgiitxqphvmitolw.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Optional: enables screenshot/image and stronger text slip extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# X API OAuth 1.0a User Context credentials for @ParlayPing.
# Never commit real credentials. Configure them in the ParlayPing Vercel project.
X_USERNAME=ParlayPing
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional override. Normally leave blank; /users/me resolves @ParlayPing automatically.
X_USER_ID=

# Protects /api/x-worker from arbitrary invocation.
X_WORKER_SECRET=

# Safety gates. Keep both false until X has granted any required approval
# and the bot has passed dry-run QA.
X_AI_REPLY_APPROVED=false
X_AUTOREPLY_ENABLED=false
