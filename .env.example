# Public site URL used in generated Tail What's Left and shared-betslip links.
PUBLIC_BASE_URL=https://parlayping.net

# Server-side secret used to sign self-contained premade betslip/share URLs.
# Use a long random value (32+ characters). Never expose this to browser code.
PARLAYPING_SHARE_SECRET=

# Dedicated ParlayPing Supabase project. The publishable key is safe for browser use.
# The Vercel app intentionally does NOT need a Supabase service-role key; privileged
# API-key validation and Stripe webhook plan sync stay inside Supabase Edge Functions.
SUPABASE_URL=https://avwqjgiitxqphvmitolw.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Developer API Billing — SANDBOX ONLY. No public paid checkout until the
# private Parlay Ping Supabase webhook, paid entitlements and lifecycle tests pass.
# Keep false on public Render; false is also the default when omitted.
PARLAYPING_BILLING_SANDBOX_ENABLED=false
# When explicitly testing owner-only checkout, use only a Stripe sk_test_ key.
# Never mix production keys with these sandbox-only Price IDs.
STRIPE_SECRET_KEY=
STRIPE_STARTER_PRICE_ID=price_1UPC14LJU3n7oe0PWXlzXBDx
STRIPE_PRO_PRICE_ID=price_1UPC1CLJU3n7oe0PnBVQIZd0
STRIPE_BUSINESS_PRICE_ID=price_1UPC1HLJU3n7oe0Pm1WkA86y
# Stripe sandbox customer Billing Portal configuration. Do not reuse for live mode.
STRIPE_SANDBOX_PORTAL_CONFIG_ID=bpc_1UPNFeLJU3n7oe0PdK88tDIS
# Comma-separated Supabase user UUIDs approved for sandbox checkout; empty by default.
PARLAYPING_BILLING_TESTER_USER_IDS=
# STRIPE_WEBHOOK_SECRET belongs in the PRIVATE PARLAY PING Supabase project
# Edge Function secrets, not Render; verify it before enabling any checkout.

# Optional: enables screenshot/image and stronger text slip extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# The Odds API is used only for on-demand sportsbook deeplink / selection-ID enrichment.
# Keep the real key server-side in Vercel. Never expose it in browser code or commit it.
ODDS_API_KEY=

# X API OAuth 1.0a User Context credentials for @ParlayPing.
# Never commit real credentials. Configure them in the ParlayPing Vercel project.
X_USERNAME=ParlayPing
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional override. Normally leave blank; /users/me resolves @ParlayPing automatically.
X_USER_ID=

# Protects /api/x-worker from arbitrary invocation.
X_WORKER_SECRET=

# Safety gates. Keep both false until X has granted any required approval
# and the bot has passed dry-run QA.
X_AI_REPLY_APPROVED=false
X_AUTOREPLY_ENABLED=false
